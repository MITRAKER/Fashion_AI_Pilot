# Template. Copy to .env and fill in real values — .env is gitignored.
# Keys are per-person. Do not share them, and never send them in a message.
#
# Gemini (image generation and image editing) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Google Books (reference catalogue metadata only — metadata never authorises
# ingestion of book content; see D-06)
GOOGLE_BOOKS_API_KEY=your_key_here

# The Met needs no key. V&A needs no key.
